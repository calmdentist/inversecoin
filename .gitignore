/coverage/
lcov.info

# Local configuration and signing material; keep shareable templates
.env
.env.*
!.env.example
!.env.*.example
/secrets/
/keystores/
*.key
*.pem

# Python caches and virtual environments
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Local editor, operating-system, and log files
.DS_Store
._*
.idea/
.vscode/
*.swp
*.swo
*~
*.log
