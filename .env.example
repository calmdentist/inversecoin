# Copy to .env and replace addresses; do not put keys in this file.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
EXPECTED_CHAIN_ID=4663
POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951
DEPLOYER=0x0000000000000000000000000000000000000000
QUOTE_TOKEN=0x0000000000000000000000000000000000000000
# Example: 1 billion shares (18 decimals), 1,000 quote units (6 decimals).
INITIAL_SHARES=1000000000000000000000000000
INITIAL_QUOTE=1000000000
FEE_PPM=3000
# Optional: leave zero for deterministic full deployment/resume.
# Set to an existing hook to finish a deployment created by the older two-step scripts.
# Initialization permanently locks the seed liquidity.
INVERSE_HOOK=0x0000000000000000000000000000000000000000
# Keep unchanged on retries. Change only when intentionally creating a separate market.
SALT_START=0
# Enable optional read-only fork tests with these separate variables.
# ROBINHOOD_FORK_RPC=https://rpc.mainnet.chain.robinhood.com
# ROBINHOOD_FORK_BLOCK=62023274
